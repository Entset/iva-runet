# Конфиг market-order. Скопируй в ~/.config/market-order/config.env, chmod 600.
# Личные данные (телефон, адрес, лимит) — только там, в git не попадают.

# Площадки, которые используем (в навыке реализованы market, wb)
SITES="market,wb"

# Режим по умолчанию для корзины: GUEST (без входа) или AUTH (вход владельца).
# GUEST по умолчанию: меньше следов, заказ всё равно завершает владелец.
DEFAULT_MODE=GUEST

# WB: телефон для входа (SMS-код присылает владелец в чат, Ива его не добывает сама).
# Пример: +79991234567. Шаблон-заглушка из навыка — не вписывать.
PHONE_WB=

# Адрес доставки (для карточек владельца: показывает самому при оформлении).
DELIVERY_LABEL="Город, улица, дом"

# Лимит суммы корзины, ₽. Если корзина дороже — Ива предупреждает и останавливается.
# 0 или пусто = лимит выключен.
LIMIT_ORDER_RUB=

# Слежение за ценой (references/04-monitor.md):
# порог срабатывания в % от прошлой цены и минимальный шаг в ₽; ниже — тишина.
WATCH_THRESHOLD_PCT=5
WATCH_DELTA_RUB=100

# Пауза между проверками слежения, часы (cron ставится по ней).
WATCH_INTERVAL_H=6